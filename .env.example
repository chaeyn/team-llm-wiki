# team-llm-wiki: copy to .env; replace placeholders, never commit real values.
# Team identity, URLs, repository, models and prompts belong in wiki.config.yaml.
# Absolute server path of your separately managed Markdown Git checkout:
WIKI_HOST_PATH=/path/to/your/wiki-checkout
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional LLM and Notion credentials (provider/model/roots are in YAML):
# LLM_API_KEY=your-llm-api-key
# NOTION_TOKEN=your-notion-integration-token
# WIKI_SERVICE_KEY=replace-with-a-separate-random-read-only-service-key
# WIKI_MEASUREMENT_SECRET=replace-with-a-separate-random-measurement-secret

# Optional Draft PR bot: install a GitHub App on the wiki repository first.
# WIKI_GITHUB_APP_CLIENT_ID=your-github-app-client-id
# WIKI_GITHUB_APP_PRIVATE_KEY_HOST_PATH=/path/to/your/wiki-bot.pem
# COMPOSE_FILE=compose.yaml:compose.wiki-updates.yaml

# Local development overrides (npm does not automatically load .env):
# AUTH_MODE=disabled
# WIKI_ROOT=/path/to/your/wiki-checkout
# WIKI_CONFIG=/path/to/wiki.config.yaml
# WIKI_WEB_URL=http://127.0.0.1:3000
# WIKI_CHAT_PATH=/path/to/local/chat.sqlite
# Optional public URL / org / repo overrides remain supported:
# PUBLIC_BASE_URL=https://wiki.example.com
# GITHUB_ORG=your-org
# WIKI_GITHUB_REPOSITORY=your-org/your-wiki
# LLM_BASE_URL=https://llm.example.com/v1
# LLM_MODEL=your-model-name
